{
  "name": "lord-v4d3r",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LORD-V4D3R - an Imperial chat console powered by Claude. A static, browser-only client: bring your own Anthropic credential and it never leaves your browser.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "web": "node scripts/serve.js",
    "vendor": "esbuild scripts/vendor-entry.js --bundle --format=esm --platform=browser --target=es2022 --minify --legal-comments=none --outfile=web/js/vendor/anthropic-sdk.js"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "esbuild": "^0.28.2"
  }
}
